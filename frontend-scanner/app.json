{
  "expo": {
    "name": "Vision Fund Scanner",
    "slug": "vision-fund-scanner",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Vision Fund Scanner to use your location to log where assets are scanned."
        }
      ],
      "expo-sqlite"
    ]
  }
}
